# Okane backend settings. Copy to backend/.env and adjust; every value below is the default.
# No secrets are needed: the app runs locally and talks only to a local Ollama.

# --- Paths (relative paths resolve from where uvicorn is started; absolute is safest) ---
# Folder holding everything confidential. Git-ignored except .gitkeep files.
# OKANE_DATA_DIR=../data
# Watched folder: dropping a Payroll or Fixed assets workbook here starts a run. It may be a
# synced SharePoint/OneDrive/Teams folder (A38); Okane only reads and copies from it. Real data
# goes in a cloud folder only if the mentor allows it.
# OKANE_INBOX_DIR=../data/inbox
# Okane's own store (current extract per kind) and archive of replaced extracts (A38).
# Empty = <OKANE_DATA_DIR>/extracts and <OKANE_DATA_DIR>/archive.
# OKANE_EXTRACTS_DIR=../data/extracts
# OKANE_ARCHIVE_DIR=../data/archive
# Largest upload accepted, in MB.
# OKANE_UPLOAD_MAX_MB=50
# Synthetic workbooks from `make generate-sample-data`; used when no extract has been loaded.
# OKANE_SAMPLE_DIR=../data/sample
# EUR rate table: currency,units_per_eur,as_of (copied from backend/tests/data/rates.sample.csv by `make setup`).
# OKANE_RATES_PATH=../data/rates.csv
# DuckDB file: one snapshot per ingested workbook set, one result set per run.
# OKANE_DB_PATH=../data/okane.duckdb
# Where `make fixtures` writes the synthetic JSON fixtures the frontend develops against.
# OKANE_FIXTURES_DIR=../fixtures
# Built frontend served by `make serve`.
# OKANE_FRONTEND_DIST=../frontend/dist

# --- Analysis date (YYYY-MM-DD). Empty = the day the Payroll extract was taken (A38). ---
# OKANE_AS_OF=

# --- Local language model (comments only; never sets numbers) ---
# OKANE_OLLAMA_URL=http://localhost:11434
# OKANE_OLLAMA_MODEL=qwen2.5:7b-instruct
# OKANE_OLLAMA_TIMEOUT_S=60
# false = always use the deterministic template comment.
# OKANE_AI_ENABLED=true
# During a run, draft and cache comments for this many top-ranked exceptions (0 = on demand only).
# OKANE_AI_PREDRAFT_TOP=3

# --- API ---
# JSON list of allowed browser origins (the Vite dev server only).
# OKANE_CORS_ORIGINS=["http://localhost:5173"]
# Name written to the change log when the client does not send one.
# OKANE_DEFAULT_USER=controller

# --- Jobs ---
# Watch OKANE_INBOX_DIR and start a run when a workbook lands.
# OKANE_ENABLE_WATCHER=true
# Weekly scheduled run (APScheduler cron).
# OKANE_ENABLE_SCHEDULER=true
# OKANE_SCHEDULE_DAY_OF_WEEK=mon
# OKANE_SCHEDULE_HOUR=6
# OKANE_SCHEDULE_MINUTE=0
# Seconds to wait after the last file event before starting a run.
# OKANE_WATCHER_DEBOUNCE_S=2
# Start one run at startup when the database has none yet.
# OKANE_RUN_ON_STARTUP=true

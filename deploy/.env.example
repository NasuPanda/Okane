# Copy to deploy/.env on the VM (git-ignored) and fill in. Never commit the real file.

# Site addresses, comma-separated. On a VM: for example a DuckDNS name and the sslip.io name of the
# public IP (dots replaced by dashes). Locally: localhost
OKANE_HOSTNAMES=okane.duckdns.org, 203-0-113-10.sslip.io

# Basic auth. Make the hash with:
#   docker run --rm caddy:2.11.9 caddy hash-password --plaintext 'the-password'
# Keep the single quotes: the hash contains $ signs.
OKANE_AUTH_USER=okane
OKANE_AUTH_HASH='paste-the-hash-here'
